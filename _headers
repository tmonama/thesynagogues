# Cloudflare Pages headers

# ── Give page — allow Turnstile + PayFast ──────────────────────────────────
/give.html
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://campushub-api-8x2k.onrender.com https://challenges.cloudflare.com; form-action https://www.payfast.co.za 'self'; img-src 'self' data: https:;
  Permissions-Policy: xr-spatial-tracking=()

# ── Video range requests ────────────────────────────────────────────────────
/assets/hero.mp4
  Content-Type: video/mp4
  Accept-Ranges: bytes
  Cache-Control: public, max-age=31536000, immutable

# ── Images & assets ─────────────────────────────────────────────────────────
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ── HTML — always revalidate ─────────────────────────────────────────────────
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# ── JS/CSS ───────────────────────────────────────────────────────────────────
/*.js
  Cache-Control: public, max-age=86400

/*.css
  Cache-Control: public, max-age=86400
